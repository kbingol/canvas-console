{
  "name": "@canvas-console/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@canvas-console/contracts": "*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0"
  }
}
