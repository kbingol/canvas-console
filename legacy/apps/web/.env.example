# demo: isolated local preview; firebase: real Firebase login + management API.
VITE_APP_MODE=demo
# Empty uses the Vite development proxy. Production must point to the Cloud Run API.
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=algomim-agents.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=algomim-agents
VITE_FIREBASE_STORAGE_BUCKET=algomim-agents.firebasestorage.app
# Only for Identity Platform multi-tenancy; match API FIREBASE_TENANT_ID.
VITE_FIREBASE_TENANT_ID=
# Optional local Firebase Auth emulator; never set for a production build.
VITE_FIREBASE_AUTH_EMULATOR_URL=
